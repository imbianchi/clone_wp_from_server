# Copy this file to .env and fill in the values
# cp .env.example .env

SITE_NAME=My Site

# SSH access to the remote server
SSH_USER=user_ssh
SSH_HOST=0.0.0.0
SSH_KEY=~/.ssh/id_rsa
WP_PATH=/home/yourserverpath/webapps/my-site

# Theme git repo — remove these lines if the theme is not in a separate repository
# THEME_GIT_PATH=/home/user/projects/my-theme
# THEME_WP_FOLDER=my-theme
# THEME_BUILD_CMD=npm run build
